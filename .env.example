# Copie este arquivo para ".env" e preencha o que quiser usar. Tudo é GRATUITO e opcional.
# O bot lê o .env sozinho (npm start / npm run dev usam --env-file-if-exists=.env do Node).

# !ouvir — transcrição de áudio pela Groq (Whisper Large v3 Turbo).
# Plano gratuito sem cartão: ~2.000 pedidos/dia e ~8 h de áudio/dia.
# Crie a chave em https://console.groq.com/keys (só precisa de uma conta).
# Sem esta chave, o bot usa Hugging Face Spaces, que têm cota anônima pequena.
GROQ_API_KEY=

# !ouvir e !rbg — token GRATUITO do Hugging Face, que aumenta a cota dos Spaces.
# Crie em https://huggingface.co/settings/tokens (tipo "Read").
HF_TOKEN=

# !traduz, !curiosidade, !free — e-mail para o MyMemory: o limite gratuito sobe de
# ~5.000 para ~50.000 caracteres por dia. Nenhum cadastro é necessário.
MYMEMORY_EMAIL=

# !ig (e reserva de !yt/!play) — caminho do yt-dlp. Deixe vazio para usar bin/,
# instalado com: npm run setup:yt-dlp
YTDLP_PATH=

# Caminho do ffmpeg. O Docker já define /usr/bin/ffmpeg. Deixe vazio para usar o do npm.
FFMPEG_PATH=

# !scanlinks e !scan — chave GRÁTIS do VirusTotal (crie conta em https://www.virustotal.com e copie a
# API key do seu perfil). Limite gratuito: 4 consultas por minuto e 500 por dia. Uso não comercial.
VIRUSTOTAL_API_KEY=

# !addlive (Twitch) — opcional, mais confiável que ler o site. Grátis em https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# !addlive (Kick) — opcional. Grátis em https://kick.com/settings/developer
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Motor de documentos (!pdf, !ocr, !topdf, !pdfdocx). Padrões pensados para o Orange Pi 5.
DOC_MAX_INPUT_MB=25
DOC_MAX_OUTPUT_MB=64
DOC_MAX_PAGES=200
DOC_MAX_OCR_PAGES=30
DOC_TIMEOUT_S=180
DOC_CONCURRENCY=1
DOC_MAX_QUEUE=10
# Só para desenvolvimento no Windows: roda as ferramentas dentro do WSL (ex.: Ubuntu-24.04)
DOC_TOOLS_WSL=

# !upload (storage.to) — opcional. Sem token: 50 arquivos/dia por IP, links valem 3 dias (até 7).
# Com um token de conta GRÁTIS (https://storage.to, em API tokens) não há limite diário de arquivos.
STORAGETO_API_TOKEN=
# Tamanho máximo que o bot baixa e envia (MB)
STORAGETO_MAX_MB=100

# Mensagens mais antigas que isso (enviadas com o bot desligado) não disparam comandos (minutos)
MAX_MESSAGE_AGE_MIN=10
# Tempo máximo esperando o WhatsApp entregar as mensagens pendentes ao conectar (segundos)
READY_FALLBACK_S=180

# Diagnóstico (deixe vazio no uso normal):
# DEBUG_MESSAGES=1 mostra no log o caminho de cada mensagem recebida (sem o conteúdo)
DEBUG_MESSAGES=
# BAILEYS_LOG_LEVEL=warn mostra avisos internos da conexão com o WhatsApp (silent, warn, info, debug)
BAILEYS_LOG_LEVEL=

# Backup automático da pasta storage (bancos e sessão) em .tar.gz
# BACKUP_ENABLED=0 desliga. Horário (0-23, Brasília), quantos guardar e pasta de destino.
BACKUP_ENABLED=
BACKUP_HOUR=4
BACKUP_KEEP=7
BACKUP_DIR=

# Backup no Google Drive (grátis): cliente OAuth do tipo "TVs e dispositivos de entrada limitada"
# criado no Google Cloud (passo a passo em docs/DOCKER.md). Depois, no privado do bot: !backup drive
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
# Nome da pasta no Drive e quantos backups manter lá (padrão: o mesmo de BACKUP_KEEP)
GDRIVE_FOLDER=Sinforoso Backups
GDRIVE_KEEP=
# País usado para conferir se os jogos grátis podem ser resgatados (Epic/Steam)
FREEGAMES_COUNTRY=BR

# Rastreio dos Correios com histórico (!rastreio): chave grátis da API do Site Rastreio / Wonca Labs
# (https://www.siterastreio.com.br/api-correios, 1.000 consultas/mês). Sem chave: só valida e manda o link.
RASTREIO_API_KEY=
# Consultas novas por pessoa por dia (0 = sem limite; admins do bot não têm limite)
RASTREIO_LIMITE_DIA=10
# DEBUG_RASTREIO=1 mostra no log a resposta da API (para ajustes)
DEBUG_RASTREIO=

# !yt: tamanho máximo do vídeo (MB) e resolução máxima. Escolhe a melhor qualidade que couber, sem recomprimir.
YT_MAX_MB=50
YT_MAX_HEIGHT=1080

# Sorteios: chave mestra do cofre das chaves dos prêmios (64 caracteres hex). Vazio = gerada em
# storage/giveaway-vault.key. Definir aqui separa a chave do backup. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GIVEAWAY_VAULT_KEY=
